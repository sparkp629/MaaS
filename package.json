{
  "name": "maas",
  "private": true,
  "scripts": {
    "dev": "npx concurrently -n api,app -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "start": "npx kill-port 3001 5173 5174 2>nul & npm run dev",
    "dev:api": "npm run dev --prefix backend",
    "dev:app": "npm run dev --prefix frontend",
    "test:lifecycle": "node scripts/test-lifecycle.mjs",
    "test:prepush": "npm run test:lifecycle",
    "sync-skills": "xcopy /E /I /Y \".cursor\\skills\" \"%USERPROFILE%\\.cursor\\skills\"",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "wrangler": "^4.69.0"
  }
}
