# MaaS — Variables d'environnement
# Copier en .env et remplir les valeurs (ne pas commiter .env)

# Supabase
API_KEY_SUPABASE=
URL_SUPABASE=

# Apify (scraping)
API_KEY_APIFY=

# X API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Stripe (payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Backend
PORT=3001
NODE_ENV=development
