# ===== MaaS - Variables d'environnement =====
# Copier vers .env et remplir les valeurs
# ATTENTION: Ne jamais commiter .env contenant des secrets (clés Stripe live, tokens, etc.)

# Stripe — paiements
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (optionnel)
SUPABASE_URL=
SUPABASE_KEY=

# Apify (optionnel, scraping)
APIFY_TOKEN=

# X (Twitter) API v2 — requis pour impressions réelles
TWITTER_BEARER_TOKEN=

# reCAPTCHA v3 (optionnel, page paiement)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Serveur
PORT=3001
NODE_ENV=development
