# ===== MaaS - Variables d'environnement =====
# Copier vers .env et remplir les valeurs

# Supabase (optionnel)
SUPABASE_URL=
SUPABASE_KEY=

# Apify (optionnel, scraping)
APIFY_TOKEN=

# X (Twitter) API v2 — requis pour impressions réelles
TWITTER_BEARER_TOKEN=

# Serveur
PORT=3001
NODE_ENV=development
