# MaaS — Variables d'environnement
# Copier en .env et coller les clés après le = (ne pas commiter .env)

PORT=3001

# Stripe — Checkout Magic Button (obligatoire pour paiement)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Supabase — Auth + DB (optionnel, SQLite utilisé par défaut)
API_KEY_SUPABASE=
URL_SUPABASE=

# Apify — Scraping X/Newsletters (optionnel)
API_KEY_APIFY=

# SQLite — chemin fichier local (optionnel, pas de clé API)
# DB_PATH=./backend/maas.db

# Stratégie frontend — default | dashboard-first | login-first
# VITE_STRATEGY=default
