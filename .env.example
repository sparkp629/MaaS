# ===== MaaS - Variables d'environnement =====
# Copier vers .env et remplir les valeurs

# Supabase (optionnel)
SUPABASE_URL=
SUPABASE_KEY=

# Apify (optionnel, scraping)
APIFY_TOKEN=

# X (Twitter) API v2 — requis pour impressions réelles
TWITTER_BEARER_TOKEN=

# Serveur
PORT=3001
NODE_ENV=development

# CORS (liste séparée par des virgules)
# Exemple prod: https://maas.votre-domaine.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optionnel: chemin absolu vers le dossier frontend buildé
# FRONTEND_DIST_PATH=/var/www/maas/frontend/dist

# Optionnel: chemin absolu vers la base SQLite
# Exemple Docker: /data/maas.db
# DATABASE_PATH=/opt/maas/shared/maas.db
