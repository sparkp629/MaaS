# Supabase — Auth + DB
# VITE_ dérivés automatiquement depuis URL_SUPABASE et API_KEY_SUPABASE par vite.config
URL_SUPABASE=
API_KEY_SUPABASE=
PUBLIC_ANON_KEY_SUPABASE=
publishableKey_SUPABASE=
secretKey_SUPABASE=
PUBLISHABLE_KEY_SUPABASE=

# Apify — Scraping (X, newsletters)
API_KEY_APIFY=

# X (Twitter) — API v2
X_BEARER_TOKEN= # ou TWITTER_BEARER_TOKEN=
API_KEY_X=
SECRET_KEY_X=
JETSON_TOKEN_X=
SECRET_JETSON_TOKEN_X=
X_CONSUMER_KEY=
X_CONSUMER_SECRET_KEY=
X_TOKEN_ACCESS=
X_TOKEN_ACCESS_SECRET=

# YouTube — Data API v3
YOUTUBE_API_KEY=
# ou GOOGLE_API_KEY= (si partagé avec d'autres services Google)
API_KEY_YOUTUBE=

# LinkedIn — Marketing API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (Facebook, Instagram) — Graph API
META_APP_ID=
META_APP_SECRET=

# TikTok — Marketing API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# SQLite — chemin fichier local (optionnel, pas de clé API)
# DB_PATH=./backend/maas.db

# Stripe Webhook Secret (optionnel en dev, requis en prod)
STRIPE_WEBHOOK_SECRET=
# Par défaut: ne pas sauvegarder les paiements en base
MAAS_PERSIST_PAYMENTS=false

# LLM — Contenu IA (un seul requis : Anthropic OU OpenAI)
# Pour la génération de contenu (threads X, posts LinkedIn, scripts courts) — "Codex" dans le projet
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Cloud / infra keys (present in local .env)
CLOUDFLARE_API_KEY=
STORE_ID_CLOUDFLARE=
ACCOUNT_ID=

# AWS / Secrets
AWS_ACCESS_KEY_ID=
AWS_ARN=
AWS_ARN_SECRET=

# Vercel / AI Gateway
AI_GATEWAY_API_KEY=

# OAuth / Google
OAUTH_CLIENT_ID=

# Stratégie frontend — default | dashboard-first | login-first
# VITE_STRATEGY=default
