# /etc/sudoers.d/maas-deploy
#
# Permet au user de déploiement de redémarrer le service sans mot de passe.
# Remplacer "deploy" par votre utilisateur SSH (ex: ubuntu).
#
# Installation:
#   sudo cp infra/systemd/maas-sudoers /etc/sudoers.d/maas-deploy
#   sudo visudo -cf /etc/sudoers.d/maas-deploy

deploy ALL=NOPASSWD: /bin/systemctl restart maas
deploy ALL=NOPASSWD: /bin/systemctl is-active maas
